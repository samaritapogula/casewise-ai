# Configure a free-tier Gemini API key for LLM-assisted intake.
# Leave blank to use the explicit, fully local guided demo mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CASEWISE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Frontend build setting (frontend/.env.local):
# VITE_API_BASE_URL=http://localhost:8000
